{
  "name": "kwh-meter-pzem004t",
  "version": "2.0.0",
  "description": "IoT Smart kWh Meter (ESP32 + PZEM-004T) with Vercel API, Firebase RTDB, Mock Simulator, and Realtime Web Dashboard",
  "main": "api/telemetry.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "simulator": "node simulator/index.js",
    "simulator:dev": "node simulator/index.js http://localhost:3000/api/telemetry",
    "simulator:production": "node simulator/index.js https://kwh-meter-pzem004t.vercel.app/api/telemetry",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "esp32",
    "pzem004t",
    "iot",
    "kwh-meter",
    "energy-monitor",
    "firebase",
    "vercel"
  ],
  "author": "naufalx",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.6.0"
  }
}
